{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arthlabs-site",
  "compatibility_date": "2026-07-01",
  "main": "./src/worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker must see every request to route by Host
    // (links.arthlabs.dev, www → apex); static files are served via env.ASSETS.
    "run_worker_first": true,
    // Unknown paths get dist/404.html with status 404.
    "not_found_handling": "404-page"
  },
  // Declared explicitly so `wrangler deploy` keeps the current state:
  // apex + www were custom domains set in the dashboard; links is new.
  "routes": [
    { "pattern": "arthlabs.dev", "custom_domain": true },
    { "pattern": "www.arthlabs.dev", "custom_domain": true },
    { "pattern": "links.arthlabs.dev", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "send_email": [
    { "name": "SEB", "destination_address": "contato@arthlabs.dev" }
  ]
}
