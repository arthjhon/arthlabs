---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import NowList from '../components/NowList.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { pickFeatured, byDateDesc } from '../lib/content';
import { t } from '../i18n/pt';

const featured = pickFeatured(await getCollection('projects'));
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc).slice(0, 3);
---

<Layout>
  <Hero />
  <ProofStrip />

  <div class="container home">
    <section class="section" aria-labelledby="now-title">
      <div class="section-head" data-reveal>
        <h2 class="section-title" id="now-title">{t.now.title}</h2>
      </div>
      <NowList />
    </section>

    {featured.length > 0 && (
      <section class="section" aria-labelledby="projects-title">
        <div class="section-head" data-reveal>
          <h2 class="section-title" id="projects-title">{t.home.selected}</h2>
          <a class="section-link" href="/projects">{t.home.allProjects}</a>
        </div>
        <ProjectList projects={featured} />
      </section>
    )}

    {posts.length > 0 && (
      <section class="section" aria-labelledby="posts-title">
        <div class="section-head" data-reveal>
          <h2 class="section-title" id="posts-title">{t.home.writing}</h2>
          <a class="section-link" href="/blog">{t.home.allPosts}</a>
        </div>
        <PostList posts={posts} />
      </section>
    )}
  </div>
</Layout>

<style>
  .home { padding-bottom: var(--space-16); }
  .home > .section:first-child { margin-top: 0; }
</style>
