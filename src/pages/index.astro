---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogItem from '../components/BlogItem.astro';
import Skills from '../components/Skills.astro';
import NowBuilding from '../components/NowBuilding.astro';
import ContactCTA from '../components/ContactCTA.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const stats = {
  projects: allProjects.length,
  live: allProjects.filter((p) => p.data.status === 'active').length,
  posts: allPosts.length,
};
---

<Layout>
  <section class="hero-section">
    <div class="grid-bg"></div>
    <div class="hero-glow"></div>
    <div class="hero-glow hero-glow-2"></div>
    <div class="hero">
      <div class="hero-eyebrow">personal lab · infra · iot · automation</div>
      <div class="hero-prompt">
        <span class="hero-prompt-user">arthur@arthlabs</span><span class="hero-prompt-sep">:</span><span class="hero-prompt-path">~</span><span class="hero-prompt-dollar">$</span>
        <span class="hero-prompt-text" data-cycle></span><span class="cursor"></span>
      </div>
      <h1>
        Building things<br />
        that <span class="accent">monitor</span>,<br />
        <span class="accent2">connect</span> & scale.
      </h1>
      <p class="hero-sub">
        Engenheiro de infra e maker. Homelab, automação, monitoramento e IoT —
        de ESP32 ao Proxmox, do MQTT ao Grafana.
      </p>

      <div class="hero-stats">
        <div class="stat">
          <div class="stat-value">{stats.projects}</div>
          <div class="stat-label">// projects</div>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <div class="stat-value accent">{stats.live}</div>
          <div class="stat-label">// live</div>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <div class="stat-value">{stats.posts}</div>
          <div class="stat-label">// writeups</div>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <div class="stat-value accent2">24/7</div>
          <div class="stat-label">// homelab</div>
        </div>
      </div>

      <div class="hero-actions">
        <a class="btn-primary" href="/projects">
          <span>ver projetos</span>
          <span class="btn-arrow">→</span>
        </a>
        <a class="btn-secondary" href="#contact">falar comigo</a>
      </div>
    </div>
  </section>

  <section class="page" style="padding-top: 0;">
    <div class="section-header" data-reveal>
      <span class="section-label">stack & expertise</span>
      <div class="section-line"></div>
      <span class="section-meta">9 áreas</span>
    </div>
    <p class="section-intro" data-reveal>
      Áreas onde tenho experiência prática — homelab, produção em PMEs ou em projetos pessoais.
    </p>
    <Skills />

    <div class="section-header" data-reveal>
      <span class="section-label">projetos em destaque</span>
      <div class="section-line"></div>
      <a href="/projects" class="section-meta-link">ver todos →</a>
    </div>

    <div class="projects-grid">
      {featured.map((p) => (
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          tags={p.data.tags}
          status={p.data.status}
          github={p.data.github}
          demo={p.data.demo}
          writeup={p.data.writeup}
          slug={p.id}
        />
      ))}
    </div>

    <div class="section-header" data-reveal>
      <span class="section-label">now / building</span>
      <div class="section-line"></div>
    </div>
    <NowBuilding />

    <div class="section-header" data-reveal>
      <span class="section-label">últimos posts</span>
      <div class="section-line"></div>
      <a href="/blog" class="section-meta-link">ver todos →</a>
    </div>

    <div class="blog-list">
      {posts.map((p) => (
        <BlogItem
          title={p.data.title}
          excerpt={p.data.excerpt}
          date={p.data.date}
          tags={p.data.tags}
          slug={p.id}
          dateFormat="short"
        />
      ))}
    </div>

    <div id="contact"></div>
    <ContactCTA />
  </section>

  <script>
    const COMMANDS = [
      'ssh arthur@homelab.local',
      'docker ps --format "{{.Names}}"',
      'pct list',
      'zabbix-cli host.list',
      'mosquitto_sub -t sensors/#',
      'kubectl get pods -A',
      'pfctl -s states | wc -l',
      'systemctl status zabbix-server',
      'journalctl -u nginx -f',
      'influx -execute "SHOW DATABASES"',
    ];

    let cycleAbort = false;

    const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

    const typeText = async (out: HTMLElement, text: string) => {
      out.textContent = '';
      for (let i = 0; i < text.length; i++) {
        if (cycleAbort) return;
        out.textContent = text.slice(0, i + 1);
        const ch = text[i];
        const delay = ch === ' ' ? 40 : 45 + Math.random() * 70;
        await sleep(delay);
      }
    };

    const eraseText = async (out: HTMLElement) => {
      const txt = out.textContent || '';
      for (let i = txt.length; i > 0; i--) {
        if (cycleAbort) return;
        out.textContent = txt.slice(0, i - 1);
        await sleep(18 + Math.random() * 12);
      }
    };

    const startCycle = async () => {
      const out = document.querySelector<HTMLElement>('[data-cycle]');
      if (!out) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        out.textContent = COMMANDS[0];
        return;
      }
      cycleAbort = false;
      const order = [...COMMANDS].sort(() => Math.random() - 0.5);
      let idx = 0;
      await sleep(250);
      while (!cycleAbort) {
        await typeText(out, order[idx % order.length]);
        if (cycleAbort) return;
        await sleep(1800);
        if (cycleAbort) return;
        await eraseText(out);
        if (cycleAbort) return;
        await sleep(220);
        idx++;
      }
    };

    const typing = () => {
      cycleAbort = true;
      setTimeout(() => { cycleAbort = false; startCycle(); }, 40);
    };

    const reveal = () => {
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        els.forEach((el) => el.classList.add('is-revealed'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      els.forEach((el) => io.observe(el));
    };
    typing();
    reveal();
    document.addEventListener('astro:page-load', () => {
      typing();
      reveal();
    });
  </script>
</Layout>
