---
// Served at https://links.arthlabs.dev (the worker rewrites "/" on that host
// to this page and 301s arthlabs.dev/links there).
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RackMark from '../components/RackMark.astro';
import LinksCarousel from '../components/LinksCarousel.astro';
import { links, icons } from '../data/links';
import { highlights } from '../data/highlights';
import { pickFeatured } from '../lib/content';
import { t } from '../i18n/pt';

const featured = pickFeatured(await getCollection('projects'));
const hasAffiliate = highlights.some((h) => h.affiliate);
---

<Layout
  title="Arthur Jhonathas · arThLabs"
  description="Links do Arthur Jhonathas — site, GitHub, LinkedIn, Instagram e contato."
  canonical="https://links.arthlabs.dev"
  bare
>
  <div class="links-page">
    <header class="head">
      <img class="photo" src="/images/arthur.webp" width="640" height="640" alt="" />
      <h1 class="display">Arthur Jhonathas</h1>
      <p class="role">{t.home.role}</p>
      <p class="bio">{t.links.bio}</p>
    </header>

    <ul class="tiles" role="list" aria-label={t.links.tiles}>
      {links.map((l) => {
        const external = !l.href.startsWith('mailto:');
        return (
          <li>
            <a class="link-tile" style={`--c: var(--brand-${l.brand})`} href={l.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <span class="icon" set:html={icons[l.icon]} />
              <span class="name">{l.label}</span>
            </a>
          </li>
        );
      })}
    </ul>

    <LinksCarousel highlights={highlights} projects={featured} />

    <footer class="foot">
      {hasAffiliate && <p class="affiliate-note">{t.links.affiliate}</p>}
      <a class="foot-brand" href="https://arthlabs.dev" aria-label="arthlabs.dev"><RackMark size={20} /><span>arthlabs.dev</span></a>
    </footer>
  </div>
</Layout>

<style>
  .links-page {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-12);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    overflow-x: clip;
  }
  .head { display: grid; justify-items: center; text-align: center; gap: var(--space-2); }
  .photo { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-border); }
  h1 { font-size: var(--text-2xl); margin-top: var(--space-2); }
  .role { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent-2); }

  .bio {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 32ch;
  }

  .tiles {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .link-tile {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
  }
  .icon {
    display: grid;
    place-items: center;
    width: min(58px, 100%);
    aspect-ratio: 1;
    border-radius: 16px;
    color: var(--c);
    background: color-mix(in oklab, var(--c) 7%, var(--color-surface));
    border: 1px solid color-mix(in oklab, var(--c) 45%, var(--color-border));
    transition: border-color var(--dur) var(--ease);
  }
  .icon :global(svg) { width: 24px; height: 24px; }
  .name {
    max-width: 100%;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .link-tile:hover .icon,
  .link-tile:focus-visible .icon,
  .link-tile:active .icon { border-color: var(--c); }
  @media (prefers-reduced-motion: reduce) {
    .icon { transition: none; }
  }

  .foot {
    margin-top: auto;
    display: grid;
    gap: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .foot-brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    text-decoration: none;
  }
  .affiliate-note { font-family: var(--font-sans); }
</style>
