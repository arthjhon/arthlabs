---
// Served at https://links.arthlabs.dev (the worker rewrites "/" on that host
// to this page and 301s arthlabs.dev/links there).
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LinksCarousel from '../components/LinksCarousel.astro';
import { links, icons } from '../data/links';
import { highlights } from '../data/highlights';
import { pickFeatured } from '../lib/content';
import { t } from '../i18n/pt';

const featured = pickFeatured(await getCollection('projects'));
const hasAffiliate = highlights.some((h) => h.affiliate);
---

<Layout
  title="Arthur Jhonathas · arThLabs"
  description="Links do Arthur Jhonathas — site, blog, GitHub, LinkedIn, Instagram e contato."
  canonical="https://links.arthlabs.dev"
  bare
>
  <div class="links-page">
    <div class="top"><ThemeToggle /></div>
    <header class="head">
      <img class="photo" src="/images/arthur.webp" width="640" height="640" alt="" />
      <h1>Arthur Jhonathas</h1>
      <p class="role">{t.home.role}</p>
    </header>

    <ul class="tiles" role="list" aria-label={t.links.tiles}>
      {links.map((l) => {
        const external = !l.href.startsWith('mailto:');
        return (
          <li>
            <a class="link-tile" href={l.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <span class="icon" set:html={icons[l.icon]} />
              <span class="name">{l.label}</span>
            </a>
          </li>
        );
      })}
    </ul>

    <LinksCarousel highlights={highlights} projects={featured} />

    <footer class="foot">
      {hasAffiliate && <p class="affiliate-note">{t.links.affiliate}</p>}
      <a href="https://arthlabs.dev">arthlabs.dev</a>
    </footer>
  </div>
</Layout>

<style>
  .links-page {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-12);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    overflow-x: clip;
  }
  .top { display: flex; justify-content: flex-end; }
  .head { display: grid; justify-items: center; text-align: center; gap: var(--space-2); }
  .photo { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-border); }
  h1 { font-size: var(--text-xl); margin-top: var(--space-2); }
  .role { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); }

  .tiles {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .link-tile {
    aspect-ratio: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .icon { display: inline-flex; color: var(--color-muted); transition: color var(--dur) var(--ease); }
  .icon :global(svg) { width: 28px; height: 28px; }
  .name { font-size: var(--text-sm); font-weight: 500; }
  .link-tile:hover,
  .link-tile:focus-visible { border-color: var(--color-accent); color: var(--color-text); }
  .link-tile:hover .icon,
  .link-tile:focus-visible .icon { color: var(--color-accent); }

  .foot {
    margin-top: auto;
    display: grid;
    gap: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .affiliate-note { font-family: var(--font-sans); }
</style>
