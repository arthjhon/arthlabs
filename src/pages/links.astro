---
// Served at https://links.arthlabs.dev (the worker rewrites "/" on that host
// to this page and 301s arthlabs.dev/links there).
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { links, icons } from '../data/links';
import { t } from '../i18n/pt';
---

<Layout
  title="Arthur Jhonathas · arThLabs"
  description="Links do Arthur Jhonathas — site, blog, GitHub, LinkedIn, Instagram, TeraNex e contato."
  canonical="https://links.arthlabs.dev"
  bare
>
  <div class="links-page">
    <div class="top"><ThemeToggle /></div>
    <header class="head">
      <img class="photo" src="/images/arthur.webp" width="640" height="640" alt="" />
      <h1>Arthur Jhonathas</h1>
      <p class="role">{t.home.role}</p>
    </header>

    <ul class="list" role="list">
      {links.map((l) => {
        const external = !l.href.startsWith('mailto:');
        return (
          <li>
            <a class="link-item" href={l.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <span class="icon" set:html={icons[l.icon]} />
              <span class="name">{l.label}</span>
              <span class="handle">{l.handle}</span>
            </a>
          </li>
        );
      })}
    </ul>

    <footer class="foot"><a href="https://arthlabs.dev">arthlabs.dev</a></footer>
  </div>
</Layout>

<style>
  .links-page {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-12);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .top { display: flex; justify-content: flex-end; }
  .head { display: grid; justify-items: center; text-align: center; gap: var(--space-2); }
  .photo { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-border); }
  h1 { font-size: var(--text-xl); margin-top: var(--space-2); }
  .role { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); }
  .list { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .link-item {
    display: grid;
    grid-template-columns: 20px 90px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: 0 var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .link-item:hover { border-color: var(--color-accent); color: var(--color-text); }
  .icon :global(svg) { width: 18px; height: 18px; }
  .name { font-weight: 500; }
  .handle { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); text-align: right; overflow-wrap: anywhere; }
  .foot { margin-top: auto; text-align: center; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); }
</style>
