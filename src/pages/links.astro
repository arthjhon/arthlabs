---
// Served at https://links.arthlabs.dev (the worker rewrites "/" on that host
// to this page and 301s arthlabs.dev/links there).
import Layout from '../layouts/Layout.astro';
import { links, icons } from '../data/links';
---

<Layout
  title="Arthur Jhonathas · arThLabs"
  description="Links do Arthur Jhonathas — site, blog, GitHub, LinkedIn, Instagram, TeraNex e contato."
  canonical="https://links.arthlabs.dev"
  bare
>
  <section class="links-page">
    <header class="links-head">
      <div class="links-photo-frame">
        <img class="links-photo" src="/images/arthur.webp" width="640" height="640" alt="Arthur Jhonathas" />
      </div>
      <div class="hero-prompt links-prompt">$ whoami</div>
      <h1 class="links-name">Arthur Jhonathas</h1>
      <p class="links-bio">IT Infrastructure Engineer · Maker · DevOps</p>
      <div class="links-status">
        <div class="status-dot"></div>
        <span>Maceió, BR</span>
      </div>
    </header>

    <ul class="links-list" role="list">
      {links.map((l, i) => {
        const external = !l.href.startsWith('mailto:');
        return (
          <li>
            <a
              class="link-item"
              href={l.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              style={`--i: ${i}`}
            >
              <span class="link-icon" set:html={icons[l.icon]} />
              <span class="link-meta">
                <span class="link-name">{l.label}</span>
                <span class="link-handle">{l.handle}</span>
              </span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        );
      })}
    </ul>

    <footer class="links-foot">
      <a href="https://arthlabs.dev" class="nav-logo">arTh<span>Labs</span></a>
    </footer>
  </section>
</Layout>

<style>
  .links-page {
    max-width: 480px;
    margin: 0 auto;
    padding: 56px 16px 40px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .links-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .links-photo-frame {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    margin-bottom: 20px;
  }

  .links-photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 3px solid var(--bg);
  }

  .links-prompt { margin-bottom: 6px; }

  .links-name {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .links-bio {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    margin-top: 6px;
  }

  .links-status {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  .links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    min-height: 60px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
    animation: link-in 0.35s ease-out both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .link-item:hover {
    border-color: var(--accent);
    background: var(--surface2);
    transform: translateY(-1px);
  }

  .link-item:active { transform: translateY(0); }

  .link-icon {
    display: inline-flex;
    color: var(--muted);
    flex-shrink: 0;
    transition: color 0.15s;
  }

  .link-item:hover .link-icon { color: var(--accent); }

  .link-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .link-name { font-size: 14px; font-weight: 600; }

  .link-handle {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-arrow {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    transition: color 0.15s, transform 0.15s;
  }

  .link-item:hover .link-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .links-foot {
    margin-top: auto;
    text-align: center;
    padding-top: 16px;
  }

  @keyframes link-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-item { animation: none; }
  }
</style>
