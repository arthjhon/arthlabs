---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import StackTable from '../components/StackTable.astro';
import MetaBlock, { type MetaEntry } from '../components/MetaBlock.astro';
import { homelab } from '../data/experience';
import { t } from '../i18n/pt';

const homelabEntries: MetaEntry[] = homelab.map((h) => ({ key: h.label, value: h.value }));
---

<Layout title={`${t.about.title} · arThLabs`} description="Arthur Jhonathas — infraestrutura, SysAdmin, automação e IoT. Fundador da TeraNex Tecnologia.">
  <div class="container page">
    <header class="intro">
      <img class="photo" src="/images/arthur.webp" width="640" height="640" alt="" />
      <div>
        <h1>Arthur Jhonathas</h1>
        <p class="role">{t.home.role}</p>
      </div>
    </header>

    <div class="prose bio">
      <p>
        Fundador da <strong>TeraNex Tecnologia</strong> — infraestrutura e suporte gerenciado para PMEs em Maceió/AL.
        O <strong>arThLabs</strong> é onde experimento: projetos pessoais em IoT, software, automação e infra que não
        cabem no portfólio da empresa mas ensinam muito.
      </p>
    </div>

    <section class="section" aria-labelledby="exp-title">
      <div class="section-head"><h2 class="section-title" id="exp-title">{t.about.experience}</h2></div>
      <Timeline />
    </section>

    <section class="section" aria-labelledby="stack-title">
      <div class="section-head">
        <h2 class="section-title" id="stack-title">{t.about.stack}</h2>
        <span class="eyebrow">{t.about.stackLead}</span>
      </div>
      <StackTable />
    </section>

    <section class="section" aria-labelledby="homelab-title">
      <div class="section-head"><h2 class="section-title" id="homelab-title">{t.about.homelab}</h2></div>
      <MetaBlock entries={homelabEntries} />
    </section>
  </div>
</Layout>

<style>
  .intro { display: flex; align-items: center; gap: var(--space-6); }
  .photo { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-border); }
  h1 { font-size: var(--text-2xl); letter-spacing: -0.01em; }
  .role { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); margin-top: var(--space-1); }
  .bio { margin-top: var(--space-8); }
</style>
