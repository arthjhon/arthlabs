---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import StackTable from '../components/StackTable.astro';
import MetaBlock, { type MetaEntry } from '../components/MetaBlock.astro';
import { homelab } from '../data/experience';
import { t } from '../i18n/pt';

const homelabEntries: MetaEntry[] = homelab.map((h) => ({ key: h.label, value: h.value }));
---

<Layout title={`${t.about.title} · arThLabs`} description="Arthur Jhonathas — infraestrutura, SysAdmin, automação e IoT. Coordena o Projeto Sentinela.">
  <div class="container page">
    <header class="intro">
      <img class="photo" src="/images/arthur.webp" width="640" height="640" alt="" />
      <div>
        <h1 class="display">Arthur Jhonathas</h1>
        <p class="role">{t.home.role}</p>
      </div>
    </header>

    <div class="prose bio">
      <p>
        Graduando em Engenharia da Computação, com mais de três anos em infraestrutura de TI: do suporte técnico ao
        projeto, à implantação e à operação de redes, firewalls, servidores e serviços em ambientes institucionais em
        produção. Trabalho com pfSense/OPNsense e UniFi (VLANs, VPNs, 802.1X), Proxmox, Linux e Windows Server, Active
        Directory, Docker, Zabbix/Grafana e automação em Python.
      </p>
      <p>
        Coordeno o <a href="/projects/sentinela">Projeto Sentinela</a>, plataforma IoT de monitoramento da qualidade da
        água da qual projetei e mantenho a arquitetura. O <strong>arThLabs</strong> é o laboratório onde experimento,
        homelab incluído: o que não cabe no trabalho institucional mas ensina muito.
      </p>
    </div>

    <section class="section" aria-labelledby="exp-title">
      <div class="section-head"><h2 class="section-title" id="exp-title">{t.about.experience}</h2></div>
      <Timeline />
    </section>

    <section class="section" aria-labelledby="stack-title">
      <div class="section-head">
        <h2 class="section-title" id="stack-title">{t.about.stack}</h2>
        <span class="eyebrow">{t.about.stackLead}</span>
      </div>
      <StackTable />
    </section>

    <section class="section" aria-labelledby="homelab-title">
      <div class="section-head"><h2 class="section-title" id="homelab-title">{t.about.homelab}</h2></div>
      <MetaBlock entries={homelabEntries} />
    </section>
  </div>
</Layout>

<style>
  .intro { display: flex; align-items: center; gap: var(--space-6); }
  .photo { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-border); }
  h1 { font-size: var(--text-2xl); }
  .role { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent-2); margin-top: var(--space-1); }
  .bio { margin-top: var(--space-8); }
</style>
