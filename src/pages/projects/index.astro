---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const allTags = Array.from(
  new Set(projects.flatMap((p) => p.data.tags.map((t) => t.toLowerCase())))
).sort();

const statuses = ['active', 'wip', 'archived'] as const;
---

<Layout title="Projetos · arThLabs" description="Vitrine de projetos pessoais em IoT, software e infra.">
  <section class="page">
    <div class="section-header" style="margin-bottom: 8px;">
      <span class="section-label">todos os projetos</span>
      <div class="section-line"></div>
      <span class="section-meta">{projects.length} total</span>
    </div>
    <p class="term-line">$ ls -la ~/arthlabs/projects/ <span class="caret">▎</span></p>

    <div class="filter-bar" data-filter-bar>
      <div class="filter-group">
        <span class="filter-label">// status</span>
        <button class="filter-chip active" data-filter-status="all">all</button>
        {statuses.map((s) => (
          <button class={`filter-chip status-${s}`} data-filter-status={s}>{s}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">// tag</span>
        <button class="filter-chip active" data-filter-tag="all">all</button>
        {allTags.map((t) => (
          <button class="filter-chip" data-filter-tag={t}>{t}</button>
        ))}
      </div>
    </div>

    <div class="projects-grid" data-projects-grid>
      {projects.map((p) => (
        <div
          class="project-cell"
          data-status={p.data.status}
          data-tags={p.data.tags.map((t) => t.toLowerCase()).join(',')}
        >
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            status={p.data.status}
            github={p.data.github}
            demo={p.data.demo}
            writeup={p.data.writeup}
            slug={p.id}
          />
        </div>
      ))}
    </div>

    <div class="filter-empty" data-filter-empty hidden>
      <div class="hero-prompt">$ grep — no matches</div>
      <p class="about-text">Nenhum projeto encontrado com esses filtros.</p>
    </div>
  </section>

  <script>
    const setup = () => {
      const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
      const grid = document.querySelector<HTMLElement>('[data-projects-grid]');
      const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
      if (!bar || !grid) return;

      let activeStatus = 'all';
      let activeTag = 'all';

      const apply = () => {
        const cells = grid.querySelectorAll<HTMLElement>('.project-cell');
        let visible = 0;
        cells.forEach((cell) => {
          const status = cell.dataset.status || '';
          const tags = (cell.dataset.tags || '').split(',');
          const okStatus = activeStatus === 'all' || status === activeStatus;
          const okTag = activeTag === 'all' || tags.includes(activeTag);
          const show = okStatus && okTag;
          cell.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (empty) empty.hidden = visible !== 0;
      };

      bar.querySelectorAll<HTMLButtonElement>('[data-filter-status]').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeStatus = btn.dataset.filterStatus || 'all';
          bar.querySelectorAll('[data-filter-status]').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          apply();
        });
      });

      bar.querySelectorAll<HTMLButtonElement>('[data-filter-tag]').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTag = btn.dataset.filterTag || 'all';
          bar.querySelectorAll('[data-filter-tag]').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          apply();
        });
      });
    };
    setup();
    document.addEventListener('astro:page-load', setup);
  </script>
</Layout>
