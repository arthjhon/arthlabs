---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { groupByStatus } from '../../lib/content';
import { t } from '../../i18n/pt';

const groups = groupByStatus(await getCollection('projects'));
---

<Layout title={`${t.projects.title} · arThLabs`} description={t.projects.lead}>
  <div class="container page">
    <header class="page-head">
      <h1>{t.projects.title}</h1>
      <p class="lead">{t.projects.lead}</p>
    </header>

    {groups.map((g) => (
      <section class="section" aria-labelledby={`group-${g.status}`}>
        <div class="section-head">
          <h2 class="section-title" id={`group-${g.status}`}>{t.statusGroup[g.status]}</h2>
          <span class="eyebrow" aria-hidden="true">{g.items.length}</span>
        </div>
        <ProjectList projects={g.items} />
      </section>
    ))}
  </div>
</Layout>
