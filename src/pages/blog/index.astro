---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { groupByCategory } from '../../lib/content';
import { t } from '../../i18n/pt';

const groups = groupByCategory(await getCollection('blog', ({ data }) => !data.draft));
---

<Layout title={`${t.blog.title} · arThLabs`} description={t.blog.lead}>
  <div class="container page">
    <header class="page-head">
      <h1>{t.blog.title}</h1>
      <p class="lead">{t.blog.lead}</p>
    </header>

    {groups.length === 0 ? (
      <p class="empty">{t.blog.empty}</p>
    ) : (
      groups.map((g) => (
        <section class="section" aria-labelledby={`cat-${g.category}`}>
          <div class="section-head">
            <h2 class="section-title" id={`cat-${g.category}`}>{t.category[g.category]}</h2>
            <span class="eyebrow" aria-hidden="true">{g.items.length}</span>
          </div>
          <PostList posts={g.items} />
        </section>
      ))
    )}
  </div>
</Layout>

<style>
  .empty { color: var(--color-muted); max-width: var(--measure); }
</style>
