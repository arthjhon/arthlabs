---
import Layout from '../layouts/Layout.astro';

const socials = [
  { label: 'GitHub', handle: '@arthjhon', href: 'https://github.com/arthjhon', icon: 'github' },
  { label: 'LinkedIn', handle: 'arthurjhonathas', href: 'https://www.linkedin.com/in/arthurjhonathas', icon: 'linkedin' },
  { label: 'Instagram', handle: '@arth.dev_', href: 'https://instagram.com/arth.dev_', icon: 'instagram' },
  { label: 'TeraNex', handle: 'teranex.inf.br', href: 'https://teranex.inf.br', icon: 'globe' },
  { label: 'Email', handle: 'contato@arthlabs.dev', href: 'mailto:contato@arthlabs.dev', icon: 'mail' },
];

const icons = {
  github: `<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>`,
  globe: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg>`,
  mail: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.8 8.5 5.9 8.5-5.9"/></svg>`,
};
---

<Layout title="Contato · arThLabs" description="Fale com Arthur — infra, automação, IoT ou só trocar uma ideia.">
  <section class="page contact-page">
    <div class="contact-head" data-reveal>
      <div class="hero-prompt">$ contact --new</div>
      <h1 class="contact-title">Vamos <span class="accent">conversar</span>.</h1>
      <p class="contact-lead">
        Projeto de infra, automação, monitoramento ou IoT — ou só uma ideia pra trocar.
        Manda uma mensagem que eu retorno.
      </p>
    </div>

    <div class="contact-layout">
      <form class="contact-form" id="contact-form" action="/api/contact" method="POST" data-reveal>
        <div class="hp" aria-hidden="true">
          <label>Não preencha<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="field">
          <label for="name">// nome</label>
          <input id="name" name="name" type="text" required maxlength="200" autocomplete="name" placeholder="como te chamo?" />
        </div>

        <div class="field">
          <label for="email">// email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="pra onde eu respondo" />
        </div>

        <div class="field">
          <label for="message">// mensagem</label>
          <textarea id="message" name="message" required maxlength="5000" rows="6" placeholder="conta o contexto — quanto mais concreto, melhor"></textarea>
        </div>

        <button type="submit" class="btn-primary contact-submit">
          <span>enviar solicitação</span><span class="btn-arrow">→</span>
        </button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <aside class="contact-aside" data-reveal>
        <div class="aside-block">
          <div class="aside-label">// email direto</div>
          <button class="email-copy" type="button" data-email="contato@arthlabs.dev">
            <span class="email-addr">contato@arthlabs.dev</span>
            <span class="email-copy-hint">copiar</span>
          </button>
        </div>

        <div class="aside-block">
          <div class="aside-label">// redes</div>
          <div class="socials">
            {socials.map((s) => (
              <a class="social" href={s.href} target={s.icon === 'mail' ? undefined : '_blank'} rel="noopener">
                <span class="social-icon" set:html={icons[s.icon]} />
                <span class="social-meta">
                  <span class="social-name">{s.label}</span>
                  <span class="social-handle">{s.handle}</span>
                </span>
                <span class="social-arrow">↗</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script>
    function initContact() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const statusEl = document.getElementById('form-status');
      if (!form || !statusEl) return;
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      const setStatus = (kind: string, text: string) => {
        statusEl.textContent = text;
        statusEl.dataset.kind = kind;
      };

      const params = new URLSearchParams(location.search);
      if (params.get('sent')) setStatus('ok', '✓ Mensagem enviada. Retorno em breve.');
      if (params.get('error')) setStatus('err', '✗ Algo falhou. Tente de novo ou use o email direto.');

      const errors: Record<string, string> = {
        missing_fields: 'Preencha nome, email e mensagem.',
        invalid_email: 'Esse email não parece válido.',
        too_long: 'Mensagem longa demais.',
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
        setStatus('pending', 'enviando…');
        btn.disabled = true;
        try {
          const payload = Object.fromEntries(new FormData(form));
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            setStatus('ok', '✓ Mensagem enviada. Retorno em breve.');
            form.reset();
          } else {
            setStatus('err', '✗ ' + (errors[data.error] || 'Não deu pra enviar. Use o email direto.'));
          }
        } catch {
          setStatus('err', '✗ Sem resposta do servidor. Use o email direto.');
        } finally {
          btn.disabled = false;
        }
      });

      const copyBtn = document.querySelector<HTMLButtonElement>('.email-copy');
      copyBtn?.addEventListener('click', async () => {
        const hint = copyBtn.querySelector('.email-copy-hint');
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email || '');
          if (hint) {
            hint.textContent = 'copiado ✓';
            setTimeout(() => (hint.textContent = 'copiar'), 1500);
          }
        } catch {}
      });

      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-revealed'));
    }

    initContact();
    document.addEventListener('astro:page-load', initContact);
  </script>
</Layout>
