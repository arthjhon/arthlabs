---
import Layout from '../layouts/Layout.astro';
import { links, icons } from '../data/links';
import { t } from '../i18n/pt';

const socials = links.filter((l) => !['Site'].includes(l.label));
---

<Layout title={`${t.contact.title} · arThLabs`} description={t.contact.lead}>
  <div class="container page">
    <header class="page-head">
      <h1>{t.contact.title}</h1>
      <p class="lead">{t.contact.lead}</p>
    </header>

    <div class="layout">
      <form class="form" id="contact-form" action="/api/contact" method="POST">
        <div class="hp" aria-hidden="true">
          <label>Não preencha<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="field">
          <label for="name">{t.contact.name}</label>
          <input id="name" name="name" type="text" required maxlength="200" autocomplete="name" placeholder={t.contact.namePh} />
        </div>
        <div class="field">
          <label for="email">{t.contact.email}</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder={t.contact.emailPh} />
        </div>
        <div class="field">
          <label for="message">{t.contact.message}</label>
          <textarea id="message" name="message" required maxlength="5000" rows="6" placeholder={t.contact.messagePh}></textarea>
        </div>

        <button type="submit" class="button">{t.contact.submit}</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <aside class="aside">
        <div>
          <p class="eyebrow">{t.contact.direct}</p>
          <button class="email-copy" type="button" data-email="contato@arthlabs.dev" data-copy={t.contact.copy} data-copied={t.contact.copied}>
            <span>contato@arthlabs.dev</span>
            <span class="email-copy-hint">{t.contact.copy}</span>
          </button>
        </div>
        <div>
          <p class="eyebrow">{t.contact.socials}</p>
          <ul class="socials" role="list">
            {socials.map((s) => (
              <li>
                <a href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
                  <span class="icon" set:html={icons[s.icon]} />
                  <span class="name">{s.label}</span>
                  <span class="handle">{s.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>

  <script>
    function initContact() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const statusEl = document.getElementById('form-status');
      if (!form || !statusEl) return;
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      const setStatus = (kind: string, text: string) => {
        statusEl.textContent = text;
        statusEl.dataset.kind = kind;
      };

      const params = new URLSearchParams(location.search);
      if (params.get('sent')) setStatus('ok', '✓ Mensagem enviada. Retorno em breve.');
      if (params.get('error')) setStatus('err', '✗ Algo falhou. Tente de novo ou use o email direto.');

      const errors: Record<string, string> = {
        missing_fields: 'Preencha nome, email e mensagem.',
        invalid_email: 'Esse email não parece válido.',
        too_long: 'Mensagem longa demais.',
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
        setStatus('pending', 'enviando…');
        btn.disabled = true;
        try {
          const payload = Object.fromEntries(new FormData(form));
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            setStatus('ok', '✓ Mensagem enviada. Retorno em breve.');
            form.reset();
          } else {
            setStatus('err', '✗ ' + (errors[data.error] || 'Não deu pra enviar. Use o email direto.'));
          }
        } catch {
          setStatus('err', '✗ Sem resposta do servidor. Use o email direto.');
        } finally {
          btn.disabled = false;
        }
      });

      const copyBtn = document.querySelector<HTMLButtonElement>('.email-copy');
      copyBtn?.addEventListener('click', async () => {
        const hint = copyBtn.querySelector('.email-copy-hint');
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email || '');
          if (hint) {
            hint.textContent = copyBtn.dataset.copied || '';
            setTimeout(() => (hint.textContent = copyBtn.dataset.copy || ''), 1500);
          }
        } catch {}
      });
    }

    initContact();
    document.addEventListener('astro:page-load', initContact);
  </script>
</Layout>

<style>
  .layout { display: grid; gap: var(--space-12); }
  @media (min-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr) 320px; } }
  .form { display: grid; gap: var(--space-6); max-width: 560px; }
  .hp { position: absolute; left: -9999px; }
  .field { display: grid; gap: var(--space-2); }
  label { font-size: var(--text-sm); font-weight: 500; }
  input, textarea {
    font: inherit;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    min-height: 44px;
    transition: border-color var(--dur) var(--ease);
  }
  input::placeholder, textarea::placeholder { color: var(--color-muted); }
  input:focus-visible, textarea:focus-visible { border-color: var(--color-accent); }
  textarea { resize: vertical; }
  .form .button { justify-self: start; }
  .form-status { font-family: var(--font-mono); font-size: var(--text-sm); min-height: 1.6em; }
  .form-status[data-kind='ok'] { color: var(--color-accent); }
  .form-status[data-kind='err'] { color: var(--color-danger); }
  .aside { display: grid; gap: var(--space-8); align-content: start; }
  .email-copy {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    min-height: 44px;
    margin-top: var(--space-2);
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-align: left;
  }
  .email-copy:hover { border-color: var(--color-accent); }
  .email-copy-hint { color: var(--color-muted); }
  .socials { list-style: none; padding: 0; margin-top: var(--space-2); }
  .socials a {
    display: grid;
    grid-template-columns: 20px 90px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .socials a:hover { color: var(--color-accent); }
  .icon :global(svg) { width: 18px; height: 18px; }
  .handle { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); overflow-wrap: anywhere; }
</style>
