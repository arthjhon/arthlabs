---
import { t } from '../i18n/pt';
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label={t.theme.toggle} aria-pressed="false">
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: none; /* useless without JS: the OS preference applies */
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-muted);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  :global(.js) .theme-toggle { display: inline-flex; }
  .theme-toggle:hover { color: var(--color-accent); border-color: var(--color-border); }
  .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-sun { display: block; }
  :global([data-theme='dark']) .icon-moon { display: none; }
</style>

<script>
  function bindThemeToggle() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      const sync = () =>
        btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      sync();
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        const bg = next === 'dark' ? '#121413' : '#FAFAF7';
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((m) => m.setAttribute('content', bg));
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* storage blocked: the choice lasts for this page view only */
        }
        sync();
      });
    });
  }
  bindThemeToggle();
  document.addEventListener('astro:page-load', bindThemeToggle);
</script>
