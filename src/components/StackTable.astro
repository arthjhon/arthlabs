---
import { stack } from '../data/experience';
import { t } from '../i18n/pt';

const hasContext = stack.some((row) => row.context.length > 0);
---

<div class="wrap">
  <table class="stack-table">
    <thead>
      <tr>
        <th scope="col">{t.about.stackCols.area}</th>
        <th scope="col">{t.about.stackCols.tools}</th>
        {hasContext && <th scope="col">{t.about.stackCols.context}</th>}
      </tr>
    </thead>
    <tbody>
      {stack.map((row) => (
        <tr>
          <th scope="row">{row.area}</th>
          <td class="tools">{row.tools.join(' · ')}</td>
          {hasContext && <td class="ctx">{row.context.map((c) => t.about.context[c]).join(', ')}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  th, td { text-align: left; vertical-align: top; padding: var(--space-3) var(--space-3) var(--space-3) 0; border-bottom: 1px solid var(--color-border); }
  thead th { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; color: var(--color-muted); }
  tbody th { font-weight: 600; white-space: nowrap; }
  .tools { font-family: var(--font-mono); font-size: var(--text-xs); }
  .ctx { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-accent); white-space: nowrap; }
  @media (max-width: 639px) {
    thead { display: none; }
    tr { display: grid; padding-block: var(--space-3); border-bottom: 1px solid var(--color-border); }
    th, td { border: 0; padding: 0; }
    tbody th { white-space: normal; }
  }
</style>
