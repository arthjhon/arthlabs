---
import { proof } from '../data/proof';
import { t } from '../i18n/pt';
---

<div class="container" data-reveal>
  <ul class="proof" aria-label={t.home.proofLabel}>
    {proof.map((p, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <span><span class="value">{p.value}</span> <span class="label">{p.label}</span></span>
      </li>
    ))}
  </ul>
</div>

<style>
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .proof li { display: flex; gap: var(--space-4); }
  .sep { color: var(--color-muted); }
  .value { color: var(--color-text); }
  .label { color: var(--color-muted); }
  @media (max-width: 599px) {
    .sep { display: none; }
  }
</style>
