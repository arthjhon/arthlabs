---
// Highlights carousel for /links. Pure CSS scroll-snap: swipe, shift+wheel and
// arrow keys (the track is focusable) work without JS. JS only drives the dots.
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import type { Highlight } from '../data/highlights';
import { t } from '../i18n/pt';

interface Props {
  highlights: Highlight[];
  projects: CollectionEntry<'projects'>[];
}

const { highlights, projects } = Astro.props;
const total = highlights.length + projects.length;
---

{total > 0 && (
  <section class="carousel" aria-labelledby="carousel-title">
    <h2 class="visually-hidden" id="carousel-title">{t.links.carousel}</h2>
    <div class="carousel-track" role="region" aria-labelledby="carousel-title" tabindex="0">
      {highlights.map((h) => (
        <article class="card">
          <span class="badge">{h.badge}</span>
          <h3 class="card-title">{h.title}</h3>
          <p class="card-text">{h.text}</p>
          <a
            class="button"
            href={h.href}
            target="_blank"
            rel={h.affiliate ? 'sponsored noopener' : 'noopener'}
          >
            {h.cta}
          </a>
        </article>
      ))}
      {projects.map((p) => (
        <article class="card">
          <StatusBadge status={p.data.status} />
          <h3 class="card-title">{p.data.title}</h3>
          <p class="card-text">{p.data.description}</p>
          <a class="button" href={`https://arthlabs.dev/projects/${p.id}`}>{t.links.project}</a>
        </article>
      ))}
    </div>

    {total > 1 && (
      <div class="carousel-controls">
        <button type="button" class="arrow arrow-prev" aria-label={t.links.prev} disabled>‹</button>
        <div class="carousel-dots">
        {Array.from({ length: total }, (_, i) => (
          <button type="button" class="dot" aria-label={`${t.links.goTo} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
        </div>
        <button type="button" class="arrow arrow-next" aria-label={t.links.next}>›</button>
      </div>
    )}
  </section>
)}

<style>
  .carousel { display: grid; gap: var(--space-4); }

  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }

  /* Narrow screens: bleed to the viewport edge so the next card peeks out. */
  @media (max-width: 511px) {
    .carousel-track {
      margin: 0 calc(-1 * var(--space-4));
      padding: 0 var(--space-4);
      scroll-padding: 0 var(--space-4);
    }
  }
  .carousel-track:focus-visible { outline-offset: -2px; }

  .card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .card-title { font-size: var(--text-lg); line-height: 1.3; }

  .card-text {
    color: var(--color-muted);
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card .button { margin-top: auto; }
  .card:has(a:active) { border-color: var(--color-accent); }

  /* Dots need JS to track position; without it the track still scrolls. */
  .carousel-controls { display: none; align-items: center; justify-content: center; gap: var(--space-2); }
  :global(.js) .carousel-controls { display: flex; }
  .carousel-dots { display: flex; justify-content: center; }

  .arrow {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .arrow:hover:not(:disabled),
  .arrow:focus-visible,
  .arrow:active:not(:disabled) { border-color: var(--color-accent); }
  .arrow:disabled { opacity: 0.35; cursor: default; }

  @media (min-width: 640px) {
    .arrow { display: grid; }
    .carousel-controls { justify-content: space-between; }
    .carousel-track {
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .carousel-track.at-end { -webkit-mask-image: none; mask-image: none; }
  }

  .dot {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-muted);
    transition: background-color var(--dur) var(--ease), width var(--dur) var(--ease);
  }
  .dot[aria-current='true']::before {
    width: 20px;
    border-radius: 4px;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot::before, .arrow { transition: none; }
  }
</style>

<script>
  function bindCarousels() {
    document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';

      const track = root.querySelector<HTMLElement>('.carousel-track');
      const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
      if (!track || dots.length === 0) return;
      const cards = [...track.querySelectorAll<HTMLElement>('.card')];

      const setActive = (i: number) =>
        dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) setActive(cards.indexOf(e.target as HTMLElement));
          }
        },
        { root: track, threshold: 0.6 },
      );
      cards.forEach((c) => io.observe(c));

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';

      const prev = root.querySelector<HTMLButtonElement>('.arrow-prev');
      const next = root.querySelector<HTMLButtonElement>('.arrow-next');
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth;
        const atStart = track.scrollLeft <= 1;
        const atEnd = track.scrollLeft >= max - 1;
        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd;
        track.classList.toggle('at-end', atEnd);
      };
      const step = () => {
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return (cards[0]?.offsetWidth ?? track.clientWidth) + gap;
      };
      prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior }));
      next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior }));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();

      dots.forEach((d, i) =>
        d.addEventListener('click', () =>
          track.scrollTo({ left: cards[i].offsetLeft - track.offsetLeft, behavior }),
        ),
      );
    });
  }

  bindCarousels();
  document.addEventListener('astro:page-load', bindCarousels);
</script>
