---
import { links, icons } from '../data/links';
import { t } from '../i18n/pt';

const year = new Date().getFullYear();
const order = ['mail', 'github', 'linkedin'];
const shown = order.flatMap((icon) => links.filter((l) => l.icon === icon));
---

<footer class="site-footer">
  <div class="container inner">
    <ul class="socials" role="list">
      {shown.map((l) => (
        <li>
          <a href={l.href} target={l.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
            <span class="icon" set:html={icons[l.icon]} />
            <span>{l.handle}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="meta">© {year} Arthur Jhonathas · arThLabs · {t.footer.built}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); margin-top: var(--space-16); }
  .inner { padding-block: var(--space-8); display: grid; gap: var(--space-4); }
  .socials { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); list-style: none; padding: 0; }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .socials a:hover { color: var(--color-accent); }
  .icon :global(svg) { width: 16px; height: 16px; }
  .meta { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); }
</style>
