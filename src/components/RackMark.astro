---
interface Props {
  size?: number;
  title?: string;
  state?: 'up' | 'down';
}
const { size = 24, title, state = 'up' } = Astro.props;
const led = state === 'down' ? 'var(--color-danger)' : 'var(--color-accent)';
---

<svg
  class="rack-mark"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
  data-state={state === 'down' ? 'down' : undefined}
>
  {title && <title>{title}</title>}
  <rect x="2.5" y="9.5" width="27" height="13" rx="2.5" stroke="var(--color-accent-2)" stroke-width="2.2"></rect>
  <path d="M7 13.5V18.5M10.5 13.5V18.5M14 13.5V18.5" stroke="var(--color-accent-2)" stroke-width="1.8" stroke-linecap="round"></path>
  <circle cx="24" cy="16" r="2.6" fill={led}></circle>
</svg>
