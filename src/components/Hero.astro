---
import HomelabDiagram from './HomelabDiagram.astro';
import { t } from '../i18n/pt';
---

<section class="hero container">
  <div class="text">
    <h1>Arthur Jhonathas</h1>
    <p class="role">{t.home.role}</p>
    <p class="pitch">{t.home.pitch}</p>
    <div class="actions">
      <a class="button" href="/projects">{t.home.ctaProjects}</a>
      <a class="button-ghost" href="/contact">{t.home.ctaContact}</a>
    </div>
  </div>
  <div class="art">
    <HomelabDiagram />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-16) var(--space-12);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding-block: var(--space-24) var(--space-16); }
  }
  h1 { font-size: clamp(2.6rem, 5.2vw, 4.2rem); line-height: 1.02; }
  .role { margin-top: var(--space-2); font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent-2); }
  .pitch {
    margin-top: var(--space-6);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.55;
    max-width: 38ch;
  }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
</style>
