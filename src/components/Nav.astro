---
import { t } from '../i18n/pt';

const { pathname } = Astro.url;
const items = [
  { href: '/projects', label: t.nav.projects },
  { href: '/blog', label: t.nav.blog },
  { href: '/about', label: t.nav.about },
  { href: '/contact', label: t.nav.contact },
];
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label="arThLabs — início">arTh<span>Labs</span></a>
    <nav aria-label={t.nav.label}>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      {/* i18n sub-project: language switcher goes here */}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
    flex-wrap: wrap;
  }
  .logo {
    font-size: var(--text-md);
    text-decoration: none;
    margin-right: auto;
  }
  .logo span { color: var(--color-muted); font-weight: 400; }
  .logo:hover span { color: var(--color-accent); }
  nav ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  nav a:hover { color: var(--color-text); }
  nav a[aria-current='page'] { color: var(--color-accent-2); border-bottom-color: var(--color-accent-2); }
  .tools { display: flex; align-items: center; }

  @media (max-width: 639px) {
    nav { order: 3; width: 100%; margin-inline: calc(var(--space-3) * -1); }
    nav ul { overflow-x: auto; }
  }
</style>
