---
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: 'active' | 'wip' | 'archived';
  github?: string;
  demo?: string;
  writeup?: string;
  slug?: string;
}

const { title, description, tags, status, github, demo, writeup, slug } = Astro.props;
const hasPage = !!slug;
---

<article class={`project-card ${hasPage ? 'linkable' : ''}`}>
  <div class={`card-status ${status}`}>
    <div class="dot"></div>
    {status}
  </div>
  {hasPage ? (
    <a href={`/projects/${slug}`} class="card-title" style="color: var(--text);">{title}</a>
  ) : (
    <div class="card-title">{title}</div>
  )}
  <div class="card-desc">{description}</div>
  <div class="card-tags">
    {tags.map((t) => <span class="card-tag">{t}</span>)}
  </div>
  <div class="card-links">
    {github && (
      <a class="card-link" href={github} target="_blank" rel="noopener">
        <svg class="card-link-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        GitHub
      </a>
    )}
    {demo && (
      <a class="card-link" href={demo} target="_blank" rel="noopener">
        <svg class="card-link-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 7h10v10" /><path d="M7 17 17 7" />
        </svg>
        demo
      </a>
    )}
    {writeup && hasPage && (
      <a class="card-link primary" href={`/projects/${slug}`}>
        <svg class="card-link-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M9 13h6" /><path d="M9 17h6" />
        </svg>
        README
      </a>
    )}
  </div>
</article>
