---
import type { CollectionEntry } from 'astro:content';
import ProjectRow from './ProjectRow.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="project-list" role="list" data-reveal-stagger>
  {projects.map((p, i) => <ProjectRow project={p} index={i} />)}
</ul>

<style>
  .project-list { list-style: none; padding: 0; border-top: 1px solid var(--color-border); }
</style>
